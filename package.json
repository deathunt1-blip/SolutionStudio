{
  "name": "solution-studio",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch apps/server/src/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx apps/server/src/index.ts",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "import:folder": "tsx scripts/import-folder.ts",
    "eval:manifest": "tsx scripts/build-eval-manifest.ts",
    "eval:label": "tsx scripts/label-eval.ts",
    "eval:run": "tsx scripts/run-evaluation.ts",
    "eval:compare": "tsx scripts/compare-evaluations.ts",
    "eval:report": "tsx scripts/report-evaluation.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^10.1.4",
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "7.29.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "happy-dom": "^20.14.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
