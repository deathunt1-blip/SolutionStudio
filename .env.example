# Local single-process embedded PostgreSQL. Set DATABASE_URL to use a PostgreSQL server.
HOST=127.0.0.1
PORT=4310
DATA_DIR=./data
DATABASE_URL=
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_API_KEY=
LLM_MODEL=kimi-k2.6
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=3000
# External connection encryption key (64 hexadecimal characters); required in production.
# Locally, an encryption key is created in DATA_DIR and must be backed up with it.
SOURCE_SECRET_KEY=
# Optional encrypted document-password reference in SecretStore; never put a password here.
SOURCE_DOCUMENT_PASSWORD_REF=
# Python with pypdf, cryptography and msoffcrypto-tool for optional document decryption.
PDF_PYTHON=python
